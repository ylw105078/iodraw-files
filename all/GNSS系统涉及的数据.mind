741597,"text":"用途","color":"black","background":"white","layout":null},"children":[{"data":{"id":"dmlcl8v9wgw0","created":1793685912992,"text":"高精度坐标变换与地球自转建模","color":"black","background":"white","layout":null},"children":[]}]},{"data":{"id":"140390a8594e42","created":1793692744404,"text":"参数内容（EOP）","color":"black","background":"white","layout":null},"children":[{"data":{"id":"e3fa1249772e49","created":1793692744404,"text":"极移参数、UT1−UTC 等地球定向参数","color":"black","background":"white","layout":null},"children":[]}]},{"data":{"id":"19a79fa73b774c","created":1793692744404,"text":"典型产品与文件","color":"black","background":"white","layout":null},"children":[{"data":{"id":"cb160a76137240","created":1793692744404,"text":"IGS ERP 产品文件（常见 .erp）","color":"black","background":"white","layout":null},"children":[]},{"data":{"id":"554c5d8edbf045","created":1793692744404,"text":"IERS EOP 产品","color":"black","background":"white","layout":null},"children":[]}]}]},{"data":{"id":"dmlcgta1xkg0","created":1793685565601,"text":"时间辅助参数","color":"black","background":"white","layout":null},"children":[{"data":{"id":"aa65892bf0544a","created":1793685733383,"text":"来源","color":"black","background":"white","layout":null},"children":[{"data":{"id":"dmlckez0g4g0","created":1793685847915,"text":"导航电文、标准时间资料","color":"black","background":"white","layout":null},"children":[]}]},{"data":{"id":"51eadef6827147","created":1793685741597,"text":"用途","color":"black","background":"white","layout":null},"children":[{"data":{"id":"dmlclirc0js0","created":1793685934522,"text":"GPS/UTC/BDT/GST 时间转换","color":"black","background":"white","layout":null},"children":[]}]},{"data":{"id":"2430a280dfda40","created":1793685623335,"text":"主要内容","color":"black","background":"white","layout":null},"children":[{"data":{"id":"dmlciielff40","created":1793685698659,"text":"闰秒、时间系统转换参数（如 GPS−UTC、BDT−GPST）","color":"black","background":"white","layout":null},"children":[]}]},{"data":{"id":"7be8e0b430ed4d","created":1793692744404,"t