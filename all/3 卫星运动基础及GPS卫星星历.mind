{"root":{"data":{"id":"dmkmdlapbnk0","created":1793611964275,"text":"3 卫星运动基础及GPS卫星星历"},"children":[{"data":{"id":"dmkmevuvjl40","created":1793612065627,"text":"概述","expandState":"expand","layout":null},"children":[{"data":{"id":"dmkmlczgvv40","created":1793612573095,"text":"卫星的绕地运动受 地球、太阳、月球等天体引力、潮汐引力、太阳光压等力的作用","layout":null},"children":[{"data":{"id":"dmkmmqvvx400","created":1793612681718,"text":"如果将地球引力权重置为1，其它力的权重均小于1e-5","layout":null},"children":[]}]},{"data":{"id":"dmkmoc0vnbs0","created":1793612806096,"text":"摄动力与中心引力相比仅为1e-3量级","layout":null},"children":[]},{"data":{"id":"dmkmpg3bawg0","created":1793612893315,"text":"考虑摄动力的卫星运动称为 受摄运动","layout":null},"children":[]},{"data":{"id":"dmkmqrmnifc0","created":1793612996793,"text":"广播星历误差构成了GPS相对定位的主要误差来源","font-weight":"bold","color":"#ff0000","layout":null},"children":[]}]},{"data":{"id":"dmkmdvfnddc0","created":1793611986342,"text":"卫星的无摄运动","layout":null},"children":[{"data":{"id":"dmkmrguwn6o0","created":1793613051711,"text":"只考虑地球质心引力作用的卫星运动称为 无摄运动","font-weight":"bold","color":"#ff0000","layout":null},"children":[{"data":{"id":"dmkms0c2emg0","created":1793613094108,"text":"二体问题","layout":null},"children":[]},{"data":{"id":"dmkoveyqbuw0","created":1793619003266,"text":"根据开普勒定律，地球在卫星椭圆轨道的一个焦点上","layout":null},"children":[]}]},{"data":{"id":"dmkow7mmujk0","created":1793619065661,"text":"确定椭圆形状及大小需要两个参数","layout":null},"children":[{"data":{"id":"dmkowjvvqq00","created":1793619092341,"text":"长半轴 a","font-weight":"bold","layout":null},"children":[]},{"data":{"id":"dmkowm5ot1s0","created":1793619097288,"text":"偏心率 e（或者短半轴 b）","font-weight":"bold","layout":null},"children":[]}]},{"data":{"id":"dmkox043nc80","created":1793619127667,"text":"确定卫星在轨道上的位置需要一个参数","layout":null},"children":[{"data":{"id":"dmkox91avtk0","created":1793619147089,"text":"卫星与近地点之间的地心角距 V","font-weight":"bold","layout":null},"children":[]}]},{"data":{"id":"dmkoxqfkwdc0","created":1793619184957,"text":"确定轨道平面与地球体的相对位置和方向需要三个参数","layout":null},"children":[{"data":{"id":"dmkoy70jx2g0","created":1793619221054,"text":"升交点的赤经 Ω","font-weight":"bold","layout":null},"children":[{"data":{"id":"dmkozu4rb280","created":1793619349738,"text":"升交点与春分点之间的地心角距","layout":null},"children":[]}]},{"data":{"id":"dmkoyf7x2340","created":1793619238914,"text":"轨道面的倾角 i","font-weight":"bold","layout":null},"children":[{"data":{"id":"dmkp047xuqw0","created":1793619371699,"text":"卫星轨道面与地球赤道面之间的夹角","layout":null},"children":[]}]},{"data":{"id":"dmkoyjqqxpc0","created":1793619248759,"text":"近地点角距 ω","font-weight":"bold","layout":null},"children":[{"data":{"id":"dmkp0lan32g0","created":1793619408867,"text":"近地点与升交点之间的地心角距","layout":null},"children":[]}]}]},{"data":{"id":"dmkp16ixp7k0","created":1793619455081,"text":"描述卫星无摄运动的参数不止一组，其中 a e V Ω i ω ，是使用最广泛的","layout":null},"children":[{"data":{"id":"dmkp20541k00","created":1793619519549,"text":"它们被称为 开普勒轨道参数（或称 轨道根数）","layout":null},"children":[]},{"data":{"id":"dmkp34p0v000","created":1793619607824,"text":"a e Ω i ω 的大小由卫星的发射条件决定（除了 V在快速变化）","layout":null},"children":[]}]}]},{"data":{"id":"dmkmemhvac00","created":1793612045250,"text":"卫星的受摄运动","layout":null},"children":[{"data":{"id":"dmkp8m96fts0","created":1793620037869,"text":"考虑 地球引力场摄动力 日月摄动力 大气阻力 光压摄动力 潮汐摄动力 的作用称为卫星的摄动运动","font-weight":"bold","color":"#ff0000","layout":null},"children":[]},{"data":{"id":"dmkpbtjrtls0","created":1793620288839,"text":"地球引力","layout":null},"children":[{"data":{"id":"dmkpbzsabvk0","created":1793620302415,"text":"质心引力","layout":null},"children":[{"data":{"id":"dmkpc5b8hu80","created":1793620314445,"text":"视为质点","layout":null},"children":[]}]},{"data":{"id":"dmkpcdz53jc0","created":1793620333304,"text":"地球引力场摄动力","layout":null},"children":[{"data":{"id":"dmkpcj9gdqo0","created":1793620344812,"text":"由地球形状、质量不规则导致","layout":null},"children":[]},{"data":{"id":"dmkpgf0ay080","created":1793620649008,"text":"量级约为  5*1e-3 m/s²","font-weight":"bold","layout":null},"children":[{"data":{"id":"dmkpgrhl6sg0","created":1793620676175,"text":"最大，其余约为1e-6量级以下","layout":null},"children":[]}]}]}]},{"data":{"id":"dmkpdbrbsi00","created":1793620406843,"text":"日月引力","layout":null},"children":[{"data":{"id":"dmkpeg1b6740","created":1793620494517,"text":"量级约为  5*1e-6 m/s²","layout":null},"children":[]}]},{"data":{"id":"dmkpdfieyzk0","created":1793620415011,"text":"太阳辐射压力","layout":null},"children":[]},{"data":{"id":"dmkpdmxuzts0","created":1793620431182,"text":"地球潮汐作用力","layout":null},"children":[]},{"data":{"id":"dmkpdv3h63k0","created":1793620448936,"text":"大气阻力","layout":null},"children":[]}]},{"data":{"id":"dmkmeyblrpk0","created":1793612070992,"text":"GPS卫星星历","layout":null},"children":[{"data":{"id":"dmkptr9sw7k0","created":1793621694438,"text":"卫星星历是描述卫星运动轨道的信息","layout":null},"children":[{"data":{"id":"dmkpu80dfzk0","created":1793621730873,"text":"卫星星历是描述卫星运动轨道的信息,也就是说卫星星历就是一组对应某一时刻的轨道参数及其变率","font-weight":"bold","color":"#ff0000","layout":null},"children":[]},{"data":{"id":"dmkpuynocc00","created":1793621788879,"text":"预报星历（广播星历）","layout":null},"children":[{"data":{"id":"dmkpvn1jw3c0","created":1793621841960,"text":"通常包括相对于某一参考历元的开普勒轨道参数和必要的轨道摄动改正项参数","layout":null},"children":[]},{"data":{"id":"dmkpwwab1nk0","created":1793621940445,"text":"参考历元对应的星历（轨道参数）也叫 参考星历","layout":null},"children":[]},{"data":{"id":"dmkpyw11n9c0","created":1793622096613,"text":"GPS广播星历参数共有16个","expandState":"expand","layout":null},"children":[{"data":{"id":"dmkpz4q9tyo0","created":1793622115553,"text":"1个 参考时刻","layout":null},"children":[{"data":{"id":"dmkr0jglrjc0","created":1793625047094,"text":"星历表参考历元（s）","layout":null},"children":[]}]},{"data":{"id":"dmkpz9bvvvc0","created":1793622125567,"text":"6个 开普勒轨道参数","layout":null},"children":[]},{"data":{"id":"dmkpzfh39n40","created":1793622138942,"text":"9个 反应摄动力影响的参数","layout":null},"children":[]}]},{"data":{"id":"dml8cs7ky2o0","created":1793673965378,"text":"一般用户通过C/A码接收，精度为几十米","layout":null},"children":[{"data":{"id":"dml8e08cjew0","created":1793674061203,"text":"曾经因SA政策人为降低精度到100m左右","layout":null},"children":[]},{"data":{"id":"dml8e8e26w00","created":1793674078962,"text":"现SA政策已经取消","layout":null},"children":[]}]}]},{"data":{"id":"dmkpv33t9mo0","created":1793621798561,"text":"后处理星历（精密星历）","layout":null},"children":[{"data":{"id":"dml79lj2nfk0","created":1793670894633,"text":"通过地面观测得到卫星的精密轨道","layout":null},"children":[]},{"data":{"id":"dml8gaxy7wo0","created":1793674241247,"text":"美国在全球建立几十个跟踪站计算卫星的精密轨道","layout":null},"children":[{"data":{"id":"dml8gu2z13c0","created":1793674282910,"text":"但限制外部使用","layout":null},"children":[]}]},{"data":{"id":"dml8fn978pk0","created":1793674189684,"text":"非军方用户","layout":null},"children":[{"data":{"id":"dml8fsvxkds0","created":1793674201943,"text":"联合","layout":null},"children":[]},{"data":{"id":"dml8fvjz08w0","created":1793674207750,"text":"全球几百个站","layout":null},"children":[]},{"data":{"id":"dml8fyhqd7s0","created":1793674214145,"text":"一起定轨","layout":null},"children":[{"data":{"id":"dml8g3zk1540","created":1793674226107,"text":"精度达到几个厘米","layout":null},"children":[]}]}]}]},{"data":{"id":"dml8lhcvchs0","created":1793674647031,"text":"精密星历需要用户去专门网站下载","layout":null},"children":[{"data":{"id":"dml8lyoq7sw0","created":1793674684753,"text":"精密星历包括","layout":null},"children":[{"data":{"id":"dml8m8e6k9c0","created":1793674705883,"text":"igs 最终精密星历","layout":null},"children":[]},{"data":{"id":"dml8mis80go0","created":1793674728501,"text":"igr 快速精密星历","layout":null},"children":[]},{"data":{"id":"dml8mpwr3vk0","created":1793674744011,"text":"igu 预报精密星历","layout":null},"children":[]}]},{"data":{"id":"dml8n7vb9280","created":1793674783106,"text":"精密星历采用sp3格式，存储方式为ASCII文本文件","layout":null},"children":[]},{"data":{"id":"dml8o7y2qgo0","created":1793674861638,"text":"15min的更新频率","layout":null},"children":[]},{"data":{"id":"dml8oepo8hs0","created":1793674876367,"text":"目前IGS也提供四大GNSS系统的混合精密星历","layout":null},"children":[]}]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}