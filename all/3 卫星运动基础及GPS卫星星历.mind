{"root":{"data":{"id":"dmkmdlapbnk0","created":1793611964275,"text":"3 卫星运动基础及GPS卫星星历"},"children":[{"data":{"id":"dmkmevuvjl40","created":1793612065627,"text":"概述","expandState":"expand"},"children":[{"data":{"id":"dmkmlczgvv40","created":1793612573095,"text":"卫星的绕地运动受 地球、太阳、月球等天体引力、潮汐引力、太阳光压等力的作用"},"children":[{"data":{"id":"dmkmmqvvx400","created":1793612681718,"text":"如果将地球引力权重置为1，其它力的权重均小于1e-5"},"children":[]}]},{"data":{"id":"dmkmoc0vnbs0","created":1793612806096,"text":"摄动力与中心引力相比仅为1e-3量级"},"children":[]},{"data":{"id":"dmkmpg3bawg0","created":1793612893315,"text":"考虑摄动力的卫星运动称为 受摄运动"},"children":[]},{"data":{"id":"dmkmqrmnifc0","created":1793612996793,"text":"广播星历误差构成了GPS相对定位的主要误差来源"},"children":[]}]},{"data":{"id":"dmkmdvfnddc0","created":1793611986342,"text":"卫星的无摄运动"},"children":[{"data":{"id":"dmkmrguwn6o0","created":1793613051711,"text":"只考虑地球质心引力作用的卫星运动称为 无摄运动"},"children":[{"data":{"id":"dmkms0c2emg0","created":1793613094108,"text":"二体问题"},"children":[]},{"data":{"id":"dmkoveyqbuw0","created":1793619003266,"text":"根据开普勒定律，地球在卫星椭圆轨道的一个焦点上"},"children":[]}]},{"data":{"id":"dmkow7mmujk0","created":1793619065661,"text":"确定椭圆形状及大小需要两个参数"},"children":[{"data":{"id":"dmkowjvvqq00","created":1793619092341,"text":"长半轴 a"},"children":[]},{"data":{"id":"dmkowm5ot1s0","created":1793619097288,"text":"偏心率 e（或者短半轴 b）"},"children":[]}]},{"data":{"id":"dmkox043nc80","created":1793619127667,"text":"确定卫星在轨道上的位置需要一个参数"},"children":[{"data":{"id":"dmkox91avtk0","created":1793619147089,"text":"卫星与近地点之间的地心角距 V"},"children":[]}]},{"data":{"id":"dmkoxqfkwdc0","created":1793619184957,"text":"确定轨道平面与地球体的相对位置和方向需要三个参数"},"children":[{"data":{"id":"dmkoy70jx2g0","created":1793619221054,"text":"升交点的赤经 Ω"},"children":[{"data":{"id":"dmkozu4rb280","created":1793619349738,"text":"升交点与春分点之间的地心角距"},"children":[]}]},{"data":{"id":"dmkoyf7x2340","created":1793619238914,"text":"轨道面的倾角 i"},"children":[]},{"data":{"id":"dmkoyjqqxpc0","created":1793619248759,"text":"近地点角距 ω"},"children":[]}]}]},{"data":{"id":"dmkmemhvac00","created":1793612045250,"text":"卫星的受摄运动"},"children":[]},{"data":{"id":"dmkmeyblrpk0","created":1793612070992,"text":"GPS卫星星历"},"children":[]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}