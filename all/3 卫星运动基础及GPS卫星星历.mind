{"root":{"data":{"id":"dmkmdlapbnk0","created":1793611964275,"text":"3 卫星运动基础及GPS卫星星历"},"children":[{"data":{"id":"dmkmevuvjl40","created":1793612065627,"text":"概述","expandState":"expand"},"children":[{"data":{"id":"dmkmlczgvv40","created":1793612573095,"text":"卫星的绕地运动受 地球、太阳、月球等天体引力、潮汐引力、太阳光压等力的作用"},"children":[{"data":{"id":"dmkmmqvvx400","created":1793612681718,"text":"如果将地球引力权重置为1，其它力的权重均小于1e-5"},"children":[]}]},{"data":{"id":"dmkmoc0vnbs0","created":1793612806096,"text":"摄动力与中心引力相比仅为1e-3量级"},"children":[]},{"data":{"id":"dmkmpg3bawg0","created":1793612893315,"text":"考虑摄动力的卫星运动称为 受摄运动"},"children":[]},{"data":{"id":"dmkmqrmnifc0","created":1793612996793,"text":"广播星历误差构成了GPS相对定位的主要误差来源","font-weight":"bold","color":"#ff0000"},"children":[]}]},{"data":{"id":"dmkmdvfnddc0","created":1793611986342,"text":"卫星的无摄运动"},"children":[{"data":{"id":"dmkmrguwn6o0","created":1793613051711,"text":"只考虑地球质心引力作用的卫星运动称为 无摄运动","font-weight":"bold","color":"#ff0000"},"children":[{"data":{"id":"dmkms0c2emg0","created":1793613094108,"text":"二体问题"},"children":[]},{"data":{"id":"dmkoveyqbuw0","created":1793619003266,"text":"根据开普勒定律，地球在卫星椭圆轨道的一个焦点上"},"children":[]}]},{"data":{"id":"dmkow7mmujk0","created":1793619065661,"text":"确定椭圆形状及大小需要两个参数"},"children":[{"data":{"id":"dmkowjvvqq00","created":1793619092341,"text":"长半轴 a"},"children":[]},{"data":{"id":"dmkowm5ot1s0","created":1793619097288,"text":"偏心率 e（或者短半轴 b）"},"children":[]}]},{"data":{"id":"dmkox043nc80","created":1793619127667,"text":"确定卫星在轨道上的位置需要一个参数"},"children":[{"data":{"id":"dmkox91avtk0","created":1793619147089,"text":"卫星与近地点之间的地心角距 V"},"children":[]}]},{"data":{"id":"dmkoxqfkwdc0","created":1793619184957,"text":"确定轨道平面与地球体的相对位置和方向需要三个参数"},"children":[{"data":{"id":"dmkoy70jx2g0","created":1793619221054,"text":"升交点的赤经 Ω"},"children":[{"data":{"id":"dmkozu4rb280","created":1793619349738,"text":"升交点与春分点之间的地心角距"},"children":[]}]},{"data":{"id":"dmkoyf7x2340","created":1793619238914,"text":"轨道面的倾角 i"},"children":[{"data":{"id":"dmkp047xuqw0","created":1793619371699,"text":"卫星轨道面与地球赤道面之间的夹角"},"children":[]}]},{"data":{"id":"dmkoyjqqxpc0","created":1793619248759,"text":"近地点角距 ω"},"children":[{"data":{"id":"dmkp0lan32g0","created":1793619408867,"text":"近地点与升交点之间的地心角距"},"children":[]}]}]},{"data":{"id":"dmkp16ixp7k0","created":1793619455081,"text":"描述卫星无摄运动的参数不止一组，其中 a e V Ω i ω ，是使用最广泛的"},"children":[{"data":{"id":"dmkp20541k00","created":1793619519549,"text":"它们被称为 开普勒轨道参数（或称 轨道根数）"},"children":[]},{"data":{"id":"dmkp34p0v000","created":1793619607824,"text":"a e Ω i ω 的大小由卫星的发射条件决定（除了 V在快速变化）"},"children":[]}]}]},{"data":{"id":"dmkmemhvac00","created":1793612045250,"text":"卫星的受摄运动"},"children":[{"data":{"id":"dmkp8m96fts0","created":1793620037869,"text":"考虑 地球引力场摄动力 日月摄动力 大气阻力 光压摄动力 潮汐摄动力 的作用称为卫星的摄动运动"},"children":[]},{"data":{"id":"dmkpbtjrtls0","created":1793620288839,"text":"地球引力"},"children":[{"data":{"id":"dmkpbzsabvk0","created":1793620302415,"text":"质心引力"},"children":[{"data":{"id":"dmkpc5b8hu80","created":1793620314445,"text":"视为质点"},"children":[]}]},{"data":{"id":"dmkpcdz53jc0","created":1793620333304,"text":"地球引力场摄动力"},"children":[{"data":{"id":"dmkpcj9gdqo0","created":1793620344812,"text":"由地球形状、质量不规则导致"},"children":[]},{"data":{"id":"dmkpgf0ay080","created":1793620649008,"text":"量级约为  5*1e-3 m/s²","font-weight":"bold"},"children":[{"data":{"id":"dmkpgrhl6sg0","created":1793620676175,"text":"最大，其余约为1e-6量级以下"},"children":[]}]}]}]},{"data":{"id":"dmkpdbrbsi00","created":1793620406843,"text":"日月引力"},"children":[{"data":{"id":"dmkpeg1b6740","created":1793620494517,"text":"量级约为  5*1e-6 m/s²"},"children":[]}]},{"data":{"id":"dmkpdfieyzk0","created":1793620415011,"text":"太阳辐射压力"},"children":[]},{"data":{"id":"dmkpdmxuzts0","created":1793620431182,"text":"地球潮汐作用力"},"children":[]},{"data":{"id":"dmkpdv3h63k0","created":1793620448936,"text":"大气阻力"},"children":[]}]},{"data":{"id":"dmkmeyblrpk0","created":1793612070992,"text":"GPS卫星星历"},"children":[{"data":{"id":"dmkptr9sw7k0","created":1793621694438,"text":"卫星星历是描述卫星运动轨道的信息"},"children":[{"data":{"id":"dmkpu80dfzk0","created":1793621730873,"text":"也就是说卫星星历就是一组对应某一时刻的轨道参数及其变率"},"children":[]},{"data":{"id":"dmkpuynocc00","created":1793621788879,"text":"预报星历（广播星历）"},"children":[{"data":{"id":"dmkpvn1jw3c0","created":1793621841960,"text":"通常包括相对于某一参考历元的开普勒轨道参数和必要的轨道摄动改正项参数"},"children":[]},{"data":{"id":"dmkpwwab1nk0","created":1793621940445,"text":"参考历元对应的星历（轨道参数）也叫 参考星历"},"children":[]},{"data":{"id":"dmkpyw11n9c0","created":1793622096613,"text":"GPS广播星历参数共有16个","expandState":"expand"},"children":[{"data":{"id":"dmkpz4q9tyo0","created":1793622115553,"text":"1个 参考时刻"},"children":[{"data":{"id":"dmkr0jglrjc0","created":1793625047094,"text":"星历表参考历元（s）"},"children":[]}]},{"data":{"id":"dmkpz9bvvvc0","created":1793622125567,"text":"6个 开普勒轨道参数"},"children":[]},{"data":{"id":"dmkpzfh39n40","created":1793622138942,"text":"9个 反应摄动力影响的参数"},"children":[]}]}]},{"data":{"id":"dmkpv33t9mo0","created":1793621798561,"text":"后处理星历"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}