:[]},{"data":{"id":"dmgc86hangw0","created":1793177089276,"text":"行星岁差"},"children":[]}]},{"data":{"id":"dmgc0yhieaw0","created":1793176523325,"text":"历元平天球坐标系","expandState":"expand"},"children":[{"data":{"id":"dmgc197m9ug0","created":1793176546672,"text":"三轴指向不变的坐标系"},"children":[{"data":{"id":"dmgc1m6me880","created":1793176574910,"text":"认为是惯性系","font-weight":"bold","color":"#ff0000"},"children":[]}]},{"data":{"id":"dmgc32lmqmo0","created":1793176689010,"text":"取某一历元时刻的天球坐标系为基准，此后的天球坐标系在其基础上补偿章动（短周期变化），这样的坐标系称为该历元的平天球坐标系。"},"children":[]},{"data":{"id":"dmgcbczalk00","created":1793177338517,"text":"瞬时极天球坐标系与历元平天球坐标系之间的坐标变换可通过岁差与章动两次旋转变换来实现。"},"children":[]}]},{"data":{"id":"dmgcg4wci880","created":1793177712746,"text":"固定极地球坐标系"},"children":[{"data":{"id":"dmgcgglicm80","created":1793177738212,"text":"也叫 平地球坐标系"},"children":[]},{"data":{"id":"dmgcglfnyvk0","created":1793177748742,"text":"z轴指向1900~1905年地球自转轴瞬时位置的平均位置，国际协定原点 CIO"},"children":[{"data":{"id":"dmgci6cfjrs0","created":1793177872623,"text":"也成为 平地极"},"children":[]}]}]},{"data":{"id":"dmgcncdrjb40","created":1793178277585,"text":"坐标系两种定义方式"},"children":[{"data":{"id":"dmgcni9z4ao0","created":1793178290417,"text":"理论定义坐标系"},"children":[{"data":{"id":"dmgcnsp3hkw0","created":1793178313099,"text":"直接定义原点、单位长度、轴向"},"children":[]}]},{"data":{"id":"dmgcnpj45b40","created":1793178306207,"text":"协定坐标系"},"children":[{"data":{"id":"dmgco92cplc0","created":1793178348729,"text":"由一系列已知坐标的点，通过观测反过来定义该坐标系"},"children":[]}]},{"data":{"id":"dmgcpmbhiig0","created":1793178455944,"text":"这两种方式在不存在误差的情况下应该是一致的"},"children":[{"data":{"id":"dmgcro05j8g0","created":1793178616340,"text":"但是存在误差，所以他们不是完全一致"},"children":[]}]},{"data":{"id":"dmgcsbwqhsg0","created":1793178668377,"text":"所以卫星的的位置是测轨跟踪站及其坐标值所定义的协定坐标系"},"children":[{"data":{"id":"dmgcyxxn8j40","created":1793179186506,"text":"同样的定义出的接收机位置也是协议坐标系位置"},"children":[]},{"data":{"id":"dmgczh6ja5k0","created":1793179228402,"text":"可以通过激光测卫、激光测月和甚长干涉等手段使协定坐标系和理论定义的坐标系差别不大，分米级误差"},"children":[]}]}]}]},{"data":{"id":"dmgaocm8qqw0","created":1793172714242,"text":"WGS-84坐标系与我国大地坐标系"},"children":[{"data":{"id":"dmgd16e98ug0","created":1793179361653,"text":"WGS-84坐标系"},"children":[]},{"data":{"id":"dmgd210nczs0","created":1793179428310,"text":"国家大地坐标系"},"children":[]},{"data":{"id":"dmgd285gus00","created":1793179443839,"text":"地方独立坐标系"},"children":[]},{"data":{"id":"dmgd2cnx8ts0","created":1793179453662,"text":"ITRF坐标框架"},"children":[]},{"data":{"id":"dmgd2l247kw0","created":1793179471935,"text":"GLONASS PZ-90坐标系"},"children":[]}]},{"data":{"id":"dmgaop4cxsw0","created":1793172741459,"text":"坐标系统之间转换"},"children":[{"data":{"id":"dmgd2yjfm5s0","created":1793179501280,"text":"不同空间直角坐标系之间的转换"},"children":[]},{"data":{"id":"dmgd39mbsxk0","created":1793179525399,"text":"不同大地坐标系的换算"},"children":[]},{"data":{"id":"dmgd3hsy0m00","created":1793179543214,"text":"大地坐标转换为高斯平面坐标"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}