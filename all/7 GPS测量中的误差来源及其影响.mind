id":"dmqh9ihl5co0","created":1794206898895,"text":"室内微波天线测量设备精确测定"},"children":[]},{"data":{"id":"dmqh9tilyb40","created":1794206922902,"text":"旋转天线法"},"children":[]}]}]},{"data":{"id":"dmqb8hxo6so0","created":1794189892667,"text":"接收机的测量噪声"},"children":[{"data":{"id":"dmqhbrajud40","created":1794207074789,"text":"因测量设备和测量环境引起的随机误差"},"children":[]}]},{"data":{"id":"dmqb8z54uco0","created":1794189930124,"text":"信号在接收机内的时延"},"children":[{"data":{"id":"dmqi0kg2h540","created":1794209018989,"text":"信号到达接收机天线相位中心后进行放大滤波及各种处理所需的时间△t1"},"children":[]},{"data":{"id":"dmqi1o8at540","created":1794209105591,"text":"生成复制码并进入相关器的时间△t2"},"children":[]}]}]},{"data":{"id":"dmqb5x5dcbk0","created":1794189690692,"text":"其他误差"},"children":[{"data":{"id":"dmqb9avm3uw0","created":1794189955670,"text":"地球自转的影响"},"children":[]},{"data":{"id":"dmqb9jjhhi80","created":1794189974527,"text":"地球潮汐改正"},"children":[]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}