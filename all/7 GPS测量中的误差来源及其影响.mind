{"root":{"data":{"id":"dmqb4sd95400","created":1794189601921,"text":"7 GPS测量中的误差来源及其影响"},"children":[{"data":{"id":"dmqb5cr8wqw0","created":1794189646302,"text":"与卫星有关的误差"},"children":[{"data":{"id":"dmqb67s5o5k0","created":1794189713838,"text":"星历误差"},"children":[{"data":{"id":"dmqguaoui800","created":1794205706457,"text":"分支主题"},"children":[]}]},{"data":{"id":"dmqb6gqzff40","created":1794189733358,"text":"卫星的钟误差","expandState":"expand"},"children":[{"data":{"id":"dmqbz7zs01s0","created":1794191986859,"text":"卫星钟相对于标准GPS时的偏差，时刻在变"},"children":[]},{"data":{"id":"dmqc1zdjez40","created":1794192203193,"text":"一般用一个二次多项式拟合"},"children":[]},{"data":{"id":"dmqc3ncxzm00","created":1794192333764,"text":"地面控制系统根据前一段时间的跟踪资料，不断更新拟合参数"},"children":[]}]},{"data":{"id":"dmqb6udb05s0","created":1794189763006,"text":"信号在卫星内的时延"},"children":[{"data":{"id":"dmqbi7p2ty80","created":1794190654022,"text":"开始生成测距信号至信号生成并离开发射天线相位中心的时间"},"children":[{"data":{"id":"dmqd78cef7s0","created":1794195435646,"text":"一般不超过15ns，影响不超过4.5m"},"children":[]}]},{"data":{"id":"dmqbj86dq0o0","created":1794190733432,"text":"不同信号产生的电路不同、时延不同"},"children":[{"data":{"id":"dmqd0b3hi800","created":1794194893088,"text":"各时延的绝对值测量困难，但是它们之间差值计算相对容易"},"children":[]}]},{"data":{"id":"dmqcr1no0880","created":1794194167263,"text":"通常将这种时延与卫星钟差一起处理"},"children":[{"data":{"id":"dmqd8b1bgrs0","created":1794195519870,"text":"给定基准信号吸收了内部时延的钟差"},"children":[]},{"data":{"id":"dmqd97x73dk0","created":1794195591455,"text":"再给出其他信号相对于基准信号的时延差值，用户自己求需要信号的钟差"},"children":[]}]}]},{"data":{"id":"dmqb6p9owbc0","created":1794189751903,"text":"相对论效应"},"children":[]},{"data":{"id":"dmqb748ey7k0","created":1794189784478,"text":"卫星天线相位中心偏差"},"children":[{"data":{"id":"dmqbhg8avaw0","created":1794190594234,"text":"卫星质心至卫星天线相位中心的差异"},"children":[]}]}]},{"data":{"id":"dmqb5gzc0e80","created":1794189655499,"text":"与传播路径有关的误差"},"children":[{"data":{"id":"dmqb7dvjjsw0","created":1794189805467,"text":"电离层延迟"},"children":[]},{"data":{"id":"dmqb7jdekz40","created":1794189817431,"text":"对流层延迟"},"children":[]},{"data":{"id":"dmqb7mm3p9c0","created":1794189824488,"text":"多路径效应"},"children":[]}]},{"data":{"id":"dmqb5olr64w0","created":1794189672092,"text":"与接收机有关的误差"},"children":[{"data":{"id":"dmqb7tc4q000","created":1794189839122,"text":"接收机的钟误差"},"children":[{"data":{"id":"dmqdfsffwps0","created":1794196106279,"text":"数值大、规律性差"},"children":[]},{"data":{"id":"dmqdfyuno800","created":1794196120259,"text":"当作未知数"},"children":[]}]},{"data":{"id":"dmqb8d8onz40","created":1794189882449,"text":"接收机的位置误差"},"children":[]},{"data":{"id":"dmqb8hxo6so0","created":1794189892667,"text":"接收机的测量噪声"},"children":[]},{"data":{"id":"dmqb8qbahow0","created":1794189910905,"text":"接收机天线相位中心偏差"},"children":[]},{"data":{"id":"dmqb8z54uco0","created":1794189930124,"text":"信号在接收机内的时延"},"children":[]}]},{"data":{"id":"dmqb5x5dcbk0","created":1794189690692,"text":"其他误差"},"children":[{"data":{"id":"dmqb9avm3uw0","created":1794189955670,"text":"地球自转的影响"},"children":[]},{"data":{"id":"dmqb9jjhhi80","created":1794189974527,"text":"地球潮汐改正"},"children":[]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}