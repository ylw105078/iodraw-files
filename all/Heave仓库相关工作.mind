{"root":{"data":{"id":"dm2jesgwmj40","created":1791775515702,"text":"Heave仓库相关工作","expandState":"expand"},"children":[{"data":{"id":"dm2jj3sy89k0","created":1791775853832,"text":"模块层面相关工作","expandState":"expand","priority":3,"layout":null},"children":[{"data":{"id":"dm2jggfr59s0","created":1791775646240,"text":"对接输入/输出配置机制","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm3aykugkmw0","created":1791853236358,"text":"为工程后续的 log 机制提供所需的 set/get 接口，用于设置初始参数、获取过程值","expandState":"expand"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","expandState":"expand"},"children":[{"data":{"id":"dm3d86ahci00","created":1791859630537,"text":"列出本周需要设置的参数和读取的过程值，完成对应接口","expandState":"expand"},"children":[{"data":{"id":"dm3d82dkwm80","created":1791859622017,"text":"所有set/get函数的单元测试通过"},"children":[]}]}]},{"data":{"id":"dm3d6viua9k0","created":1791859528734,"text":"衡量指标","expandState":"expand"},"children":[{"data":{"id":"dm3dap2yn4w0","created":1791859828169,"text":"单元测试返回值符合预期"},"children":[]},{"data":{"id":"dm3dmzpmw540","created":1791860791678,"text":"检查设置后是否生效、读取值是否正确"},"children":[]},{"data":{"id":"dm3dn2mng3c0","created":1791860798028,"text":"非法输入是否按约定处理"},"children":[]}]}]},{"data":{"id":"dm2jjeed0nk0","created":1791775876894,"text":"抗混叠降采样自适应","layout":null,"expandState":"expand","background":"#eaf1dd"},"children":[{"data":{"id":"dm3azs8f6j40","created":1791853330804,"text":"此前固定输出 10 Hz、低通截止频率固定；需要研究提高输出频率后，低通截止频率应怎样选取","expandState":"expand","background":"#eaf1dd"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","background":"#eaf1dd"},"children":[{"data":{"id":"dm3d95d031c0","created":1791859706877,"text":"整机联调通过并不影响升沉估计精度","background":"#eaf1dd"},"children":[]}]},{"data":{"id":"dm3d6viua9k0","created":1791859528734,"text":"衡量指标","background":"#eaf1dd"},"children":[{"data":{"id":"dm3d8ytigo00","created":1791859692638,"text":"只修改输出频率，最终不同输出频率的升沉估计结果应高度相关、相关系数达0.98以上","background":"#eaf1dd"},"children":[]}]}]}]},{"data":{"id":"dm2jh8bf9m00","created":1791775706928,"text":"实时升沉链路相关工作","priority":1,"layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm2jij0fnvk0","created":1791775808572,"text":"去除尾部无用的滤波器和比例因子","layout":null,"expandState":"expand","background":"#eaf1dd"},"children":[{"data":{"id":"dm3aswqsoow0","created":1791852792073,"text":"清理此前排查漂移时临时加入的处理：尾部滤波器和直接缩放结果的比例因子","expandState":"expand","background":"#eaf1dd"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","background":"#eaf1dd"},"children":[{"data":{"id":"dm3dfjzfty80","created":1791860208893,"text":"完成删除并推送，纳入最终联合运行和结果验证","background":"#eaf1dd"},"children":[]}]}]},{"data":{"id":"dm2jicl505s0","created":1791775794586,"text":"最新状态机调试","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm3apomleps0","created":1791852539313,"text":"目标：将实时升沉链路接入现有导航状态机，与松组合、延迟升沉联合运行，要求稳定输出、不卡死、不丢帧","expandState":"expand","background":"#eaf1dd"},"children":[]},{"data":{"id":"dm3j86f3od40","created":1791876557476,"text":"截止频率自适应-实时链路","background":"transparent"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","background":"#eaf1dd"},"children":[{"data":{"id":"dm3deqrwu4g0","created":1791860145312,"text":"链路已经存在，可以联合运行即可","background":"#eaf1dd"},"children":[]}]},{"data":{"id":"dm3d6viua9k0","created":1791859528734,"text":"衡量指标","background":"#eaf1dd"},"children":[{"data":{"id":"dm3df4oje6g0","created":1791860175583,"text":"在设备上稳定运行两小时不崩溃","background":"#eaf1dd"},"children":[{"data":{"id":"dm3dm3tslvs0","created":1791860722273,"text":"松组合、实时升沉和延迟升沉同时启用；预热完成后，两条升沉输出持续更新，输入处理和输出计数符合预期","background":"#eaf1dd"},"children":[]}]}]}]}]},{"data":{"id":"dm2jhhfe73k0","created":1791775726759,"text":"延迟升沉链路相关工作","priority":2,"layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm2jiqjy0q00","created":1791775824989,"text":"缩短滤波窗口减少计算量","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm3avb14pzs0","created":1791852979902,"text":"当前双向滤波窗口为 409.6 秒；尝试缩短窗口，验证能否在减少计算量的同时满足延迟升沉性能指标","expandState":"expand"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界"},"children":[{"data":{"id":"dm3dfyjsip40","created":1791860240599,"text":"实验验证、代码修改、单元测试、整机联调全部通过"},"children":[]}]},{"data":{"id":"dm3d6viua9k0","created":1791859528734,"text":"衡量指标"},"children":[{"data":{"id":"dm3dgmhur880","created":1791860292725,"text":"满足既定精度要求，同时计算开销确实下降"},"children":[{"data":{"id":"dm3dkzhnia80","created":1791860634467,"text":"修改前后处理耗时、每秒计算开销或 CPU 占用。窗口缩短多少，也应记录下来"},"children":[]}]}]}]}]},{"data":{"id":"dm2jhrnf8ew0","created":1791775749012,"text":"文档","priority":5,"layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm2jhyawlmg0","created":1791775763493,"text":"补充详细设计文档","layout":null,"expandState":"expand","background":"#eaf1dd"},"children":[{"data":{"id":"dm3b5960d7s0","created":1791853759485,"text":"当前尚未编写，待这一阶段算法稳定后形成文档","expandState":"expand","background":"#eaf1dd"},"children":[{"data":{"id":"dm3dnzdy0340","created":1791860869335,"text":"覆盖本周交付版本的链路、模块接口、关键参数、状态机接入和时序","background":"#eaf1dd"},"children":[]}]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","background":"#eaf1dd"},"children":[{"data":{"id":"dm3dhk77hpc0","created":1791860366091,"text":"推送云端","background":"#eaf1dd"},"children":[]}]}]},{"data":{"id":"dm2ji4zwryo0","created":1791775778065,"text":"完善工作交接文档","layout":null,"expandState":"expand"},"children":[{"data":{"id":"dm3b638bz9c0","created":1791853824929,"text":"已有相关文档，在此基础上增加一份总的交接文档，串起文件位置、功能和使用方式","expandState":"expand"},"children":[{"data":{"id":"dm3do3iq7000","created":1791860878332,"text":"文件入口、构建与运行方式、配置方式、测试入口、已知问题"},"children":[]}]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界"},"children":[{"data":{"id":"dm3dhp4gm880","created":1791860376809,"text":"推送云端"},"children":[]}]}]}]},{"data":{"id":"dm2jv6r3geg0","created":1791776800620,"text":"测试","priority":4,"layout":null,"expandState":"expand","background":"#eaf1dd"},"children":[{"data":{"id":"dm2jvatoxjc0","created":1791776809484,"text":"实时和延迟两条链路都需要经过单元测试、整机联调测试","layout":null,"expandState":"expand","background":"#eaf1dd"},"children":[]},{"data":{"id":"dm3d6ssjt7k0","created":1791859522790,"text":"交付边界","background":"#eaf1dd"},"children":[{"data":{"id":"dm3dhu69qgo0","created":1791860387803,"text":"完成所需测试代码、执行单元测试和整机联调，保存结果及未解决问题","background":"#eaf1dd"},"children":[]}]}]}]},"template":"right","theme":"fresh-blue-compat","version":"1.4.43"}